[Unit]
Description=ADI-2-Pi (network remote for RME ADI-2)
Documentation=file:///opt/adi2-pi/README.md
After=network.target sound.target bluetooth.service adi2-pi-audio.service
Wants=avahi-daemon.service

[Service]
Type=simple
User=adi2pi
Group=adi2pi
SupplementaryGroups=audio
ExecStart=/usr/bin/node /opt/adi2-pi/bin/adi2-pi.js --data /var/lib/adi2-pi
# where the audio service (adi2-pi-audio) has its PipeWire socket
Environment=ADI2PI_AUDIO_RUNTIME=/run/adi2-pi-audio
Restart=always
RestartSec=2
# settings.json lives here; written only when a setting changes
StateDirectory=adi2-pi
StateDirectoryMode=0750
# allow port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# /dev/snd is needed for the ADI-2's MIDI port
DevicePolicy=closed
DeviceAllow=char-alsa rw
# /dev/gpiochip* for the ADI-2 trigger on GPIO3 (optional)
DeviceAllow=char-gpiochip rw

[Install]
WantedBy=multi-user.target
